{
  "name": "api",
  "version": "1.0.0",
  "description": "Gestão de reservas de salas",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/reserva.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prepararBanco.ts && prisma migrate deploy",
    "admin:promote": "tsx scripts/promoverAdmin.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cauaaugustow/SpaceLoop.git"
  },
