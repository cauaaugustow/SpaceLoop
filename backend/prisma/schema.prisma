// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  telefone  String?
  cpf       String   @unique
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  eadmin    Boolean  @default(false) @map("e_admin")

  @@map("usuarios")
}


model Sala{
  id        Int      @id @default(autoincrement())
  nome      String
  capacidade Int
  descricao String?
  preco     Float @map("preco_locacao")
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  
  @@map("salas")
}